{
  "name": "solexpay-admin",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/platform-server": "^17.3.12",
    "@angular/router": "^17.3.0",
    "@tanstack/angular-query-experimental": "^5.99.1",
    "aos": "^2.3.4",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.4"
  },
  "devDependencies": {
    "@analogjs/platform": "1.22.5",
    "@analogjs/vitest-angular": "^2.6.0",
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular-eslint/builder": "21.0.1",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@eslint/js": "^9.39.1",
    "@types/aos": "^3.0.7",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@vitest/coverage-v8": "^4.1.8",
    "angular-eslint": "21.0.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "jasmine-core": "~5.1.0",
    "jsdom": "^29.1.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^17.0.7",
    "msw": "^2.14.6",
    "postcss": "^8.4.35",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.3.3",
    "typescript-eslint": "8.46.4",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "src/**/*.{ts,html,css,json}": [
      "prettier --write"
    ],
    "src/**/*.ts": [
      "eslint --fix"
    ]
  }
}
